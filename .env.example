# copie para .env e ajuste
DATABASE_URL=postgres://aoe2:aoe2dev@127.0.0.1:5433/aoe2
# 32+ bytes aleatórios: openssl rand -base64 48
SESSION_SECRET=troque-isto
# URL pública do site (sem barra no fim). O Steam OpenID volta pra cá.
APP_URL=http://localhost:3000
# Fase 2: análise de partida com IA
# URL do serviço analyzer (Python). Local: uvicorn em apps/analyzer; no compose: http://analyzer:8000
ANALYZER_URL=http://127.0.0.1:8000
# Chave do OpenRouter (https://openrouter.ai/keys). Sem ela o worker marca as análises como falha.
OPENROUTER_API_KEY=
# Modelo no formato do OpenRouter. Padrão: anthropic/claude-haiku-5.5
LLM_MODEL=anthropic/claude-haiku-5.5
# Análises por conta a cada 24 h
ANALYSIS_DAILY_LIMIT=3
# Link do botão de doação (opcional). Vazio = botão não aparece.
DONATION_URL=

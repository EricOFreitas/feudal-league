{
  "name": "aoe2-ligas",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @aoe2/db generate",
    "db:migrate": "pnpm --filter @aoe2/db migrate",
    "worker": "pnpm --filter @aoe2/worker start"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
